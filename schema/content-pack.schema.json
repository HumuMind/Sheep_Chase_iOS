{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wild-sheep-chase.local/schema/content-pack.schema.json",
  "title": "Wild Sheep Chase Content Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "adventure",
    "scenes",
    "npcs",
    "monsters",
    "encounters",
    "items",
    "handouts",
    "maps",
    "rules",
    "spells",
    "flags",
    "assets"
  ],
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "adventure": { "$ref": "#/$defs/adventure" },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "npcs": {
      "type": "array",
      "items": { "$ref": "#/$defs/npc" }
    },
    "monsters": {
      "type": "array",
      "items": { "$ref": "#/$defs/monster" }
    },
    "encounters": {
      "type": "array",
      "items": { "$ref": "#/$defs/encounter" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "handouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/handout" }
    },
    "maps": {
      "type": "array",
      "items": { "$ref": "#/$defs/map" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "spells": {
      "type": "array",
      "items": { "$ref": "#/$defs/spell" }
    },
    "flags": {
      "type": "array",
      "items": { "$ref": "#/$defs/flag" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "idList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "textPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "text"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "originalTitle",
        "version",
        "schemaVersion",
        "locale",
        "usage",
        "credits",
        "minAppVersion"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "originalTitle": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "usage": {
          "type": "string",
          "enum": ["personal", "private", "public"]
        },
        "credits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "url": { "type": "string" }
            }
          }
        },
        "minAppVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "adventure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "level",
        "players",
        "durationMinutes",
        "contentWarnings",
        "sceneOrder",
        "startingScene"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "level": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "players": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "durationMinutes": { "type": "integer", "minimum": 1 },
        "contentWarnings": { "$ref": "#/$defs/stringList" },
        "sceneOrder": {
          "allOf": [
            { "$ref": "#/$defs/idList" },
            { "minItems": 1 }
          ]
        },
        "startingScene": { "$ref": "#/$defs/id" },
        "sourceRef": { "type": "string" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "summary", "beats"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "readAloud": { "type": "string" },
        "dmText": { "type": "string" },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/beat" }
        },
        "branches": {
          "type": "array",
          "items": { "$ref": "#/$defs/branch" }
        },
        "npcIds": { "$ref": "#/$defs/idList" },
        "encounterIds": { "$ref": "#/$defs/idList" },
        "handoutIds": { "$ref": "#/$defs/idList" },
        "ruleIds": { "$ref": "#/$defs/idList" },
        "spellIds": { "$ref": "#/$defs/idList" },
        "mapIds": { "$ref": "#/$defs/idList" },
        "itemIds": { "$ref": "#/$defs/idList" },
        "dmNotes": { "type": "string" },
        "sourceRef": { "type": "string" }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["event", "decision", "roleplay", "encounter", "transition", "note"]
        },
        "text": { "type": "string", "minLength": 1 },
        "readAloud": { "type": "string" },
        "requiresFlag": { "$ref": "#/$defs/id" },
        "npcIds": { "$ref": "#/$defs/idList" },
        "encounterIds": { "$ref": "#/$defs/idList" },
        "handoutIds": { "$ref": "#/$defs/idList" },
        "ruleIds": { "$ref": "#/$defs/idList" },
        "spellIds": { "$ref": "#/$defs/idList" },
        "mapIds": { "$ref": "#/$defs/idList" },
        "itemIds": { "$ref": "#/$defs/idList" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "requiresFlag": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "npc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "publicDescription",
        "dmDescription",
        "personality",
        "voice",
        "motivation",
        "attitude",
        "knows",
        "secrets",
        "wants",
        "sampleLines"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "publicDescription": { "type": "string", "minLength": 1 },
        "dmDescription": { "type": "string", "minLength": 1 },
        "personality": { "$ref": "#/$defs/stringList" },
        "voice": { "type": "string", "minLength": 1 },
        "motivation": { "type": "string", "minLength": 1 },
        "attitude": {
          "type": "string",
          "enum": ["hostile", "neutral", "friendly", "unknown"]
        },
        "knows": { "$ref": "#/$defs/stringList" },
        "secrets": { "$ref": "#/$defs/stringList" },
        "wants": { "$ref": "#/$defs/stringList" },
        "sampleLines": { "$ref": "#/$defs/stringList" },
        "keyCharacteristics": { "$ref": "#/$defs/stringList" },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "note"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "portraitAssetId": { "$ref": "#/$defs/id" },
        "sourceRef": { "type": "string" }
      }
    },
    "monster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "size",
        "type",
        "alignment",
        "ac",
        "hp",
        "speed",
        "abilities",
        "challenge",
        "actions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "alignment": { "type": "string", "minLength": 1 },
        "ac": { "$ref": "#/$defs/ac" },
        "hp": { "$ref": "#/$defs/hp" },
        "speed": { "$ref": "#/$defs/speed" },
        "abilities": { "$ref": "#/$defs/abilities" },
        "savingThrows": { "$ref": "#/$defs/stringList" },
        "skills": { "$ref": "#/$defs/stringList" },
        "damageVulnerabilities": { "$ref": "#/$defs/stringList" },
        "damageResistances": { "$ref": "#/$defs/stringList" },
        "conditionImmunities": { "$ref": "#/$defs/stringList" },
        "senses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passivePerception"],
          "properties": {
            "passivePerception": { "type": "integer", "minimum": 0 }
          }
        },
        "languages": { "$ref": "#/$defs/stringList" },
        "challenge": { "$ref": "#/$defs/challenge" },
        "traits": {
          "type": "array",
          "items": { "$ref": "#/$defs/textPair" }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/textPair" }
        },
        "tactics": { "$ref": "#/$defs/stringList" },
        "sourceRef": { "type": "string" }
      }
    },
    "ac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "hp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average", "formula"],
      "properties": {
        "average": { "type": "integer", "minimum": 1 },
        "formula": { "type": "string", "minLength": 1 }
      }
    },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walk"],
      "properties": {
        "walk": { "type": "integer", "minimum": 0 },
        "climb": { "type": "integer", "minimum": 0 },
        "fly": { "type": "integer", "minimum": 0 },
        "swim": { "type": "integer", "minimum": 0 }
      }
    },
    "abilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "type": "integer", "minimum": 1, "maximum": 30 },
        "dex": { "type": "integer", "minimum": 1, "maximum": 30 },
        "con": { "type": "integer", "minimum": 1, "maximum": 30 },
        "int": { "type": "integer", "minimum": 1, "maximum": 30 },
        "wis": { "type": "integer", "minimum": 1, "maximum": 30 },
        "cha": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "xp"],
      "properties": {
        "rating": { "type": "number", "minimum": 0 },
        "xp": { "type": "integer", "minimum": 0 }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "combatants"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "combatants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["monsterId", "count"],
            "properties": {
              "monsterId": { "$ref": "#/$defs/id" },
              "count": { "type": "integer", "minimum": 1 },
              "label": { "type": "string" }
            }
          }
        },
        "tactics": { "$ref": "#/$defs/stringList" },
        "terrain": { "type": "string" },
        "trigger": { "type": "string" },
        "difficulty": { "type": "string" },
        "sourceRef": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "pageRef": { "type": "string" },
        "sourceRef": { "type": "string" }
      }
    },
    "handout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "playerText"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["text", "image", "map"]
        },
        "playerText": { "type": "string", "minLength": 1 },
        "dmText": { "type": "string" },
        "imageAssetId": { "$ref": "#/$defs/id" }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "imageAssetId", "pins"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "imageAssetId": { "$ref": "#/$defs/id" },
        "pins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "x", "y", "dmOnly"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "minLength": 1 },
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "dmOnly": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "term", "aliases", "category", "summary", "pageRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "term": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/stringList" },
        "category": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "pageRef": { "type": "string", "minLength": 1 },
        "relatedSpellIds": { "$ref": "#/$defs/idList" }
      }
    },
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "aliases",
        "level",
        "school",
        "castingTime",
        "range",
        "components",
        "duration",
        "concentration",
        "summary",
        "pageRef"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/stringList" },
        "level": { "type": "integer", "minimum": 0, "maximum": 9 },
        "school": { "type": "string", "minLength": 1 },
        "castingTime": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "components": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "concentration": { "type": "boolean" },
        "ritual": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "pageRef": { "type": "string", "minLength": 1 }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "defaultValue"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "boolean" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "exportFilename"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["map", "cover", "handout", "illustration"]
        },
        "exportFilename": { "type": "string", "minLength": 1 },
        "credit": { "type": "string" }
      }
    }
  }
}
